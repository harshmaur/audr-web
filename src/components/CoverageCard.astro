---
import { severityClass } from "../lib/cves";
import { coverageStatusLabel, type CoverageEntry } from "../lib/coverage";

interface Props {
  entry: CoverageEntry;
}

const { entry } = Astro.props;
const severityLabel = entry.severity.toUpperCase();
---

<article class="border border-border bg-surface p-4" data-status={entry.status}>
  <div class="flex flex-col lg:flex-row lg:items-start gap-3 lg:gap-6">
    <div class="lg:w-56 shrink-0">
      <p class="font-mono text-xs text-text-muted">{entry.cve_id}</p>
      <p class="font-sans font-semibold text-base mt-1">{entry.vendor} · {entry.product}</p>
      <p class={`font-mono text-[11px] mt-2 uppercase tracking-wider ${severityClass(entry.severity)}`}>
        {severityLabel} · {coverageStatusLabel(entry.status)}
      </p>
    </div>

    <div class="flex-1 min-w-0">
      <p class="font-mono text-xs text-sev-low uppercase tracking-wider">{entry.local_signal_category}</p>
      <p class="font-sans text-sm text-text-muted mt-2">{entry.summary_short}</p>
      <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2 font-mono text-[11px] text-text-muted">
        <span>published {entry.published_date}</span>
        <span>reviewed {entry.last_seen_at}</span>
        <a href={entry.nvd_url} target="_blank" rel="noopener noreferrer">NVD →</a>
        {entry.audr_rule_id && <span class="text-sev-ok">rule: {entry.audr_rule_id}</span>}
      </div>
    </div>
  </div>
</article>
