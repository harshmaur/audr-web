---
import Base from "../layouts/Base.astro";
import Toolbar from "../components/Toolbar.astro";
import LiveTag from "../components/LiveTag.astro";
import Hero from "../components/Hero.astro";
import MiniShaiHuludCoverage from "../components/MiniShaiHuludCoverage.astro";
import ScanDemo from "../components/ScanDemo.tsx";
import PostInstallFlow from "../components/PostInstallFlow.astro";
import TrustProcurement from "../components/TrustProcurement.astro";
import CVEStrip from "../components/CVEStrip.astro";
import SampleReportTeaser from "../components/SampleReportTeaser.astro";
import Footer from "../components/Footer.astro";
import { latestCVEs, loadCVEs } from "../lib/cves";
import { getWasmSha } from "../lib/wasmSha";

const cves = loadCVEs();
const recentCVEs = latestCVEs(cves, 5);
const latestAdvisory = recentCVEs[0];
const wasmSha = getWasmSha();

const description = "audr scans Claude Code, Cursor, Codex CLI, Windsurf, MCP servers, agent skills, and GitHub Actions for risky AI-agent configuration. Offline single binary. HTML, SARIF, and JSON reports.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "audr",
  description:
    "Single static binary that scans AI coding agent configs (Claude Code, Cursor, Codex CLI, Windsurf, MCP servers, agent skills, GitHub Actions) for security misconfigurations. Offline by default.",
  applicationCategory: "SecurityApplication",
  operatingSystem: "macOS, Linux, Windows",
  url: "https://audr.dev",
  downloadUrl: "https://audr.dev/install.sh",
  softwareVersion: "0.13.0",
  license: "https://spdx.org/licenses/MIT.html",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  author: {
    "@type": "Person",
    name: "Harsh Maur",
    email: "harshmaur@gmail.com",
  },
  codeRepository: "https://github.com/harshmaur/audr",
};
---

<Base title="audr — scan your AI agent configs" description={description}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
  <Toolbar />
  <LiveTag cve={latestAdvisory} />
  <Hero />
  <MiniShaiHuludCoverage />

  <section class="audr-rule">
    <div class="max-w-page mx-auto px-6 md:px-8 py-12 md:py-16">
      <header class="mb-6">
        <p class="font-mono text-xs text-text-muted uppercase tracking-wider">
          in-browser scan · no install · runs locally in your tab
        </p>
        <h2 class="font-sans font-semibold text-2xl mt-2">
          Same engine the binary ships. Compiled to WASM. Runs in your tab.
        </h2>
        <p class="font-sans text-base text-text-muted mt-2 max-w-narrow">
          Paste a redacted config and see the same agent-posture checks Audr runs locally.
        </p>
      </header>
      <ScanDemo client:visible wasmSha={wasmSha} />
    </div>
  </section>

  <PostInstallFlow />
  <TrustProcurement />

  <CVEStrip cves={recentCVEs} />
  <SampleReportTeaser />

  <Footer />
</Base>
